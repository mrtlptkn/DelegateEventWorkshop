<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>DelegateEventWorkshop</RootNamespace>
    <AssemblyName>DelegateEventWorkshop.Api</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <!-- Bölüm 3: in-memory event-driven mimari için Mediator kütüphanesi -->
    <PackageReference Include="MediatR" Version="12.4.1" />
    <!-- Eğitim sırasında endpoint'leri tarayıcıdan denemek için Swagger UI -->
    <PackageReference Include="Swashbuckle.AspNetCore" Version="6.6.2" />
  </ItemGroup>

</Project>
