{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "OrderProcessing": {
    "ValidationRules": [ "HasItems", "HasValidQuantities", "TotalWithinLimit" ],
    "DiscountRules": [ "HighValueDiscount", "PremiumCustomerDiscount", "BulkQuantityDiscount" ],
    "MaxDiscountRate": 0.30
  }
}
